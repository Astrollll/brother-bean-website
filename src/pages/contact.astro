---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";
---

<BaseLayout title="Contact" hideSuffix description="Get in touch with Brother Bean Coffee House. Send us a message or find us in Cavite.">
  <div class="h-16 lg:h-20"></div>
  <section class="py-20 lg:py-28 relative overflow-hidden">
    <div class="absolute inset-0 bg-mesh"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="section-header reveal">
        <span class="text-brand-gold font-medium text-xs uppercase tracking-[0.25em]">Get In Touch</span>
        <h1 class="font-serif text-4xl lg:text-5xl font-bold text-brand-brown mt-3 mb-4">Contact Us</h1>
        <div class="section-divider"></div>
        <p class="text-gray-500">Have a question, feedback, or just want to say hi? We'd love to hear from you.</p>
      </div>

      <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
        <div class="reveal-left">
          <div class="bg-white rounded-2xl p-8 border border-brand-cream-dark shadow-sm">
            <h3 class="font-serif font-bold text-xl text-brand-brown mb-6 flex items-center gap-3">
              <span class="w-6 h-0.5 bg-brand-gold rounded-full"></span>
              Send a Message
            </h3>
            <ContactForm />
          </div>
        </div>
        <div class="reveal-right reveal-delay-1 space-y-5">
          <div class="card-lift bg-gradient-to-br from-brand-cream to-brand-cream-dark rounded-2xl p-7 border border-brand-cream-dark hover:shadow-xl">
            <h3 class="font-serif font-bold text-xl text-brand-brown mb-6 flex items-center gap-3">
              <span class="w-6 h-0.5 bg-brand-gold rounded-full"></span>
              Other Ways to Reach Us
            </h3>
            <div class="space-y-5">
              <div class="flex items-start gap-4 group">
                <div class="w-11 h-11 rounded-2xl bg-brand-gold/10 flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#D4A853" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="2"/><path d="m22 6-10 7L2 6"/></svg>
                </div>
                <div>
                  <p class="text-xs text-gray-400 uppercase tracking-wider">Email</p>
                  <p class="text-brand-brown font-medium">yourbrotherbean@gmail.com</p>
                </div>
              </div>
              <div class="flex items-start gap-4 group">
                <div class="w-11 h-11 rounded-2xl bg-brand-gold/10 flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#D4A853" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                </div>
                <div>
                  <p class="text-xs text-gray-400 uppercase tracking-wider">Phone</p>
                  <p class="text-brand-brown font-medium">0917 172 8458</p>
                </div>
              </div>
              <div class="flex items-start gap-4 group">
                <div class="w-11 h-11 rounded-2xl bg-brand-gold/10 flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#D4A853" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                </div>
                <div>
                  <p class="text-xs text-gray-400 uppercase tracking-wider">Visit</p>
                  <p class="text-brand-brown font-medium">Dasmariñas, Cavite<br />Open Daily 9:00 AM – 7:00 PM</p>
                </div>
              </div>
            </div>
          </div>

          <div class="card-lift bg-white rounded-2xl p-7 border border-brand-cream-dark shadow-sm hover:shadow-xl">
            <h3 class="font-serif font-bold text-xl text-brand-brown mb-5 flex items-center gap-3">
              <span class="w-6 h-0.5 bg-brand-gold rounded-full"></span>
              Follow Us
            </h3>
            <div class="flex gap-4">
              <a href="#" class="w-12 h-12 rounded-2xl bg-brand-cream flex items-center justify-center text-brand-brown hover:bg-brand-gold hover:text-white hover:scale-110 hover:rotate-3 transition-all duration-300 shadow-sm" aria-label="Facebook">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              </a>
              <a href="#" class="w-12 h-12 rounded-2xl bg-brand-cream flex items-center justify-center text-brand-brown hover:bg-brand-gold hover:text-white hover:scale-110 hover:rotate-3 transition-all duration-300 shadow-sm" aria-label="Instagram">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
