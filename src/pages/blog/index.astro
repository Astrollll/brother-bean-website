---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("blog");
posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout
  title="Blog"
  hideSuffix
  description="Read the latest from Brother Bean Coffee House — coffee tips, shop updates, and community stories."
>
  <div class="h-16 lg:h-20"></div>
  <section class="py-20 lg:py-28 relative overflow-hidden">
    <div class="absolute inset-0 bg-mesh"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="section-header reveal">
        <span class="text-brand-gold font-medium text-xs uppercase tracking-[0.25em]"
          >What's Brewing</span
        >
        <h1 class="font-serif text-4xl lg:text-5xl font-bold text-brand-brown mt-3 mb-4">
          Our Blog
        </h1>
        <div class="section-divider"></div>
        <p class="text-gray-500 max-w-lg mx-auto">
          Coffee tips, shop stories, and what's brewing at Brother Bean.
        </p>
      </div>

      {
        posts.length === 0 ? (
          <div class="max-w-md mx-auto text-center py-16 reveal-scale">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="48"
              height="48"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#6B4423"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="mx-auto mb-4 opacity-30"
            >
              <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20" />
            </svg>
            <p class="text-gray-400">No posts yet. Check back soon!</p>
          </div>
        ) : (
          <div class="max-w-3xl mx-auto space-y-6">
            {posts.map((post, i) => (
              <a
                href={`/blog/${post.slug}`}
                class="block card-lift bg-white rounded-2xl p-6 border border-brand-cream-dark hover:shadow-xl reveal tilt-card"
                style={`animation-delay: ${i * 0.1}s`}
              >
                <div class="tilt-card-shine" />
                <div class="relative">
                  <div class="text-sm text-brand-gold mb-1.5 font-medium">
                    {post.data.date.toLocaleDateString("en-US", {
                      year: "numeric",
                      month: "long",
                      day: "numeric",
                    })}
                  </div>
                  <h2 class="font-serif text-xl font-bold text-brand-brown mb-2 hover:text-brand-gold transition-colors">
                    {post.data.title}
                  </h2>
                  <p class="text-gray-500 text-sm leading-relaxed">{post.data.description}</p>
                </div>
              </a>
            ))}
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
