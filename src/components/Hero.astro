<section
  class="relative min-h-screen flex items-center overflow-hidden bg-gradient-to-b from-[#1C0F08] via-brand-brown-darker to-brand-brown-dark"
  id="hero"
>
  <!-- Warm glow layers -->
  <div class="absolute inset-0 bg-noise opacity-[0.06]"></div>

  <div class="absolute inset-0 bg-mesh opacity-60"></div>

  <div class="absolute inset-0" id="heroGlowContainer">
    <div
      class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] rounded-full bg-gradient-to-br from-brand-gold/12 via-amber-500/8 to-transparent blur-[160px] animate-gradient-orbit"
      id="heroGlow"
    >
    </div>
    <div
      class="absolute bottom-0 left-0 w-[500px] h-[500px] rounded-full bg-gradient-to-tr from-amber-700/10 to-transparent blur-[140px] animate-gradient-orbit"
      style="animation-delay: -6s; animation-direction: reverse"
    >
    </div>
    <div
      class="absolute top-1/2 right-0 w-[400px] h-[400px] rounded-full bg-gradient-to-bl from-brand-gold/8 to-transparent blur-[120px] animate-gradient-orbit"
      style="animation-delay: -3s"
    >
    </div>
  </div>

  <!-- Giant decorative coffee ring -->
  <div
    class="absolute top-1/2 right-0 -translate-y-1/2 translate-x-1/4 w-[700px] h-[700px] pointer-events-none hidden lg:block"
  >
    <div class="absolute inset-0 rounded-full border border-brand-gold/8 animate-spin-slow"></div>
    <div
      class="absolute inset-[8%] rounded-full border border-brand-gold/5 animate-spin-slow"
      style="animation-direction: reverse; animation-duration: 30s"
    >
    </div>
    <div
      class="absolute inset-[18%] rounded-full border border-brand-gold/8 animate-spin-slow"
      style="animation-duration: 20s"
    >
    </div>
    <div
      class="absolute inset-[30%] rounded-full border border-brand-gold/6 animate-spin-slow"
      style="animation-direction: reverse; animation-duration: 35s"
    >
    </div>
    <div class="absolute inset-[45%] rounded-full bg-brand-gold/5 blur-3xl animate-pulse-soft">
    </div>
  </div>

  <!-- Animated pour-over lines -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none hidden lg:block">
    <svg
      class="absolute top-[5%] right-[35%] w-32 h-64 text-brand-gold/8"
      viewBox="0 0 60 120"
      fill="none"
      stroke="currentColor"
      stroke-width="0.8"
    >
      <path
        d="M30 0 C30 30 10 50 10 80 C10 100 20 110 30 120"
        class="animate-draw-line"
        style="animation-delay: 0s"
      >
        <animate
          attributeName="stroke-dashoffset"
          from="200"
          to="0"
          dur="4s"
          repeatCount="indefinite"></animate>
      </path>
      <path
        d="M30 0 C30 30 50 50 50 80 C50 100 40 110 30 120"
        class="animate-draw-line"
        style="animation-delay: 0s"
      >
        <animate
          attributeName="stroke-dashoffset"
          from="200"
          to="0"
          dur="4.5s"
          repeatCount="indefinite"></animate>
      </path>
      <path
        d="M30 0 C30 20 20 40 20 60 C20 80 30 100 30 120"
        class="animate-draw-line"
        style="animation-delay: 0s"
      >
        <animate
          attributeName="stroke-dashoffset"
          from="200"
          to="0"
          dur="5s"
          repeatCount="indefinite"></animate>
      </path>
    </svg>
  </div>

  <!-- Floating elements -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <svg
      class="absolute top-[15%] left-[8%] w-5 h-5 text-brand-gold/20 animate-particle-float"
      style="animation-delay: 0s; animation-duration: 9s"
      viewBox="0 0 24 24"
      fill="currentColor"
    >
      <ellipse cx="12" cy="12" rx="6" ry="9" transform="rotate(-20,12,12)"></ellipse><path
        d="M7 6.5c2 3 2 8 0 11"
        stroke="currentColor"
        fill="none"
        stroke-width="0.8"></path>
    </svg>
    <svg
      class="absolute top-[25%] right-[12%] w-7 h-7 text-brand-gold/15 animate-particle-float"
      style="animation-delay: -3s; animation-duration: 11s"
      viewBox="0 0 24 24"
      fill="currentColor"
    >
      <ellipse cx="12" cy="12" rx="6" ry="9" transform="rotate(15,12,12)"></ellipse><path
        d="M7 6.5c2 3 2 8 0 11"
        stroke="currentColor"
        fill="none"
        stroke-width="0.8"></path>
    </svg>
    <svg
      class="absolute top-[60%] left-[4%] w-4 h-4 text-brand-gold/20 animate-particle-float"
      style="animation-delay: -5s; animation-duration: 8s"
      viewBox="0 0 24 24"
      fill="currentColor"
    >
      <ellipse cx="12" cy="12" rx="6" ry="9" transform="rotate(-10,12,12)"></ellipse><path
        d="M7 6.5c2 3 2 8 0 11"
        stroke="currentColor"
        fill="none"
        stroke-width="0.8"></path>
    </svg>
    <svg
      class="absolute top-[75%] right-[6%] w-8 h-8 text-brand-gold/12 animate-particle-float"
      style="animation-delay: -7s; animation-duration: 10s"
      viewBox="0 0 24 24"
      fill="currentColor"
    >
      <ellipse cx="12" cy="12" rx="6" ry="9" transform="rotate(25,12,12)"></ellipse><path
        d="M7 6.5c2 3 2 8 0 11"
        stroke="currentColor"
        fill="none"
        stroke-width="0.8"></path>
    </svg>
    <svg
      class="absolute top-[40%] left-[50%] w-6 h-6 text-brand-gold/15 animate-particle-float"
      style="animation-delay: -2s; animation-duration: 12s"
      viewBox="0 0 24 24"
      fill="currentColor"
    >
      <ellipse cx="12" cy="12" rx="6" ry="9" transform="rotate(-35,12,12)"></ellipse><path
        d="M7 6.5c2 3 2 8 0 11"
        stroke="currentColor"
        fill="none"
        stroke-width="0.8"></path>
    </svg>
  </div>

  <!-- Steam arcs -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute bottom-[18%] left-[20%] w-20 h-40">
      <svg viewBox="0 0 80 160" fill="none" class="w-full h-full opacity-30">
        <path
          d="M40 160 C30 120 50 80 20 40 C10 20 20 10 30 0"
          stroke="url(#steamGrad)"
          stroke-width="2"
          stroke-linecap="round"
          class="animate-draw-line"
          style="animation-delay: 0s"
        >
          <animate
            attributeName="stroke-dashoffset"
            from="300"
            to="0"
            dur="6s"
            repeatCount="indefinite"></animate>
        </path>
        <path
          d="M40 160 C50 120 30 80 60 40 C70 20 60 10 50 0"
          stroke="url(#steamGrad)"
          stroke-width="2"
          stroke-linecap="round"
          class="animate-draw-line"
          style="animation-delay: 0s"
        >
          <animate
            attributeName="stroke-dashoffset"
            from="300"
            to="0"
            dur="7s"
            repeatCount="indefinite"></animate>
        </path>
        <path
          d="M40 160 C40 130 45 100 40 60 C38 40 42 20 40 0"
          stroke="url(#steamGrad)"
          stroke-width="1.5"
          stroke-linecap="round"
          class="animate-draw-line"
          style="animation-delay: 0s"
        >
          <animate
            attributeName="stroke-dashoffset"
            from="300"
            to="0"
            dur="5s"
            repeatCount="indefinite"></animate>
        </path>
      </svg>
    </div>
    <div class="absolute bottom-[15%] right-[25%] w-24 h-48">
      <svg viewBox="0 0 80 160" fill="none" class="w-full h-full opacity-25">
        <path
          d="M40 160 C25 120 55 80 30 40 C20 20 30 10 40 0"
          stroke="url(#steamGrad)"
          stroke-width="2"
          stroke-linecap="round"
        >
          <animate
            attributeName="stroke-dashoffset"
            from="300"
            to="0"
            dur="8s"
            repeatCount="indefinite"></animate>
        </path>
        <path
          d="M40 160 C55 120 25 80 50 40 C60 20 50 10 40 0"
          stroke="url(#steamGrad)"
          stroke-width="2"
          stroke-linecap="round"
        >
          <animate
            attributeName="stroke-dashoffset"
            from="300"
            to="0"
            dur="6.5s"
            repeatCount="indefinite"></animate>
        </path>
        <path
          d="M40 160 C45 130 35 100 45 60 C48 40 42 20 40 0"
          stroke="url(#steamGrad)"
          stroke-width="1.5"
          stroke-linecap="round"
        >
          <animate
            attributeName="stroke-dashoffset"
            from="300"
            to="0"
            dur="9s"
            repeatCount="indefinite"></animate>
        </path>
      </svg>
    </div>
  </div>

  <svg class="absolute" width="0" height="0">
    <defs>
      <linearGradient id="steamGrad" x1="0" y1="1" x2="0" y2="0">
        <stop offset="0%" stop-color="#D4A853" stop-opacity="0.3"></stop>
        <stop offset="50%" stop-color="#D4A853" stop-opacity="0.1"></stop>
        <stop offset="100%" stop-color="#D4A853" stop-opacity="0"></stop>
      </linearGradient>
    </defs>
  </svg>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-32 lg:py-40 w-full z-10">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <div class="max-w-xl">
        <div class="flex items-center gap-3 mb-5 reveal" style="animation-delay: 0.05s">
          <span class="w-8 h-px bg-brand-gold/80"></span>
          <span class="text-brand-gold font-medium text-xs uppercase tracking-[0.25em]"
            >Dasmariñas, Cavite</span
          >
        </div>
        <h1
          class="font-serif text-5xl sm:text-6xl lg:text-7xl font-bold leading-[1.1] mb-6 text-shadow-glow"
        >
          <span class="inline-block text-white reveal" style="animation-delay: 0.1s"
            >Your Daily Cup of</span
          ><br />
          <span class="inline-block reveal" style="animation-delay: 0.25s"
            ><span class="text-gradient">Warmth</span></span
          >
        </h1>
        <p
          class="text-lg lg:text-xl text-white/85 mb-10 leading-relaxed max-w-lg reveal"
          style="animation-delay: 0.35s"
        >
          Handcrafted coffee, warm conversations, and a home away from home in the heart of Cavite.
        </p>
        <div class="flex flex-wrap gap-4 reveal" style="animation-delay: 0.5s">
          <a href="/menu" class="btn-primary magnetic text-base">
            Explore Our Menu
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
            >
          </a>
          <a href="/about" class="btn-outline magnetic text-base"> Our Story </a>
        </div>
      </div>

      <div class="hidden lg:flex justify-center items-center">
        <div class="relative w-80 h-96 reveal-scale" style="animation-delay: 0.4s">
          <div
            class="absolute inset-0 bg-gradient-to-br from-brand-gold/20 to-brand-gold/5 rounded-[40px] blur-2xl animate-pulse-soft"
          >
          </div>
          <div
            class="absolute inset-0 rounded-[40px] border border-brand-gold/20"
            style="transform: translate(8px, 8px)"
          >
          </div>
          <div
            class="absolute inset-0 rounded-[40px] border border-brand-gold/10"
            style="transform: translate(-8px, -8px)"
          >
          </div>
          <div
            class="absolute top-6 left-6 w-72 h-80 rounded-[32px] border border-white/10 bg-white/5 backdrop-blur-sm flex items-center justify-center overflow-hidden shadow-2xl"
          >
            <div
              class="absolute inset-0 bg-gradient-to-br from-transparent via-white/5 to-transparent"
            >
            </div>
            <img
              src="/brother-bean-logo.jpg"
              alt="Brother Bean Coffee House"
              class="w-full h-full object-cover relative z-10 scale-110"
            />
          </div>
        </div>
      </div>
    </div>
  </div>

  <div
    class="absolute bottom-0 left-0 right-0 h-40 bg-gradient-to-t from-brand-cream via-brand-cream/70 to-transparent z-10"
  >
  </div>
</section>

<script>
  const hero = document.getElementById("hero");
  if (hero) {
    hero.addEventListener("mousemove", (e) => {
      const rect = hero.getBoundingClientRect();
      const x = (e.clientX - rect.left) / rect.width;
      const y = (e.clientY - rect.top) / rect.height;
      const glow = document.getElementById("heroGlowContainer");
      if (glow) {
        glow.style.transform = `translate(${(x - 0.5) * 20}px, ${(y - 0.5) * 20}px)`;
      }
    });
  }
</script>
