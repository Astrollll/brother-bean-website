<!-- Newsletter success popup -->
<div
  id="newsletter-success-overlay"
  class="fixed inset-0 z-50 flex items-center justify-center bg-black/40 backdrop-blur-sm opacity-0 pointer-events-none transition-all duration-500"
>
  <div
    class="bg-white rounded-3xl p-10 max-w-sm mx-4 text-center shadow-2xl scale-95 transition-transform duration-500"
  >
    <div
      class="w-16 h-16 mx-auto mb-5 rounded-full bg-gradient-to-br from-brand-gold to-brand-gold-dark flex items-center justify-center"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="28"
        height="28"
        viewBox="0 0 24 24"
        fill="none"
        stroke="white"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline
          points="22 4 12 14.01 9 11.01"></polyline></svg
      >
    </div>
    <h3 class="font-serif text-2xl font-bold text-brand-brown mb-2">You're In!</h3>
    <p class="text-gray-500 mb-6">
      Thanks for joining — we'll keep you posted on events and new menu items.
    </p>
    <button
      id="newsletter-close-btn"
      class="px-6 py-2.5 rounded-xl bg-brand-cream text-brand-brown font-medium hover:bg-brand-gold hover:text-white transition-all duration-300"
    >
      Got it
    </button>
  </div>
</div>

<script>
  declare global {
    interface Window {
      formspree: {
        (action: string, options?: Record<string, unknown>): void;
        q?: unknown[];
      };
    }
    var formspree: Window["formspree"];
  }
  window.formspree =
    window.formspree ||
    function () {
      (formspree.q = formspree.q || []).push(arguments);
    };
  formspree("initForm", {
    formElement: "#newsletter-form",
    formId: "mjgnzlpe",
    onSuccess: function () {
      (document.getElementById("newsletter-form") as HTMLFormElement).reset();
      document
        .getElementById("newsletter-success-overlay")
        .classList.remove("opacity-0", "pointer-events-none");
      document
        .getElementById("newsletter-success-overlay")
        .querySelector("div:first-child")
        .classList.remove("scale-95");
    },
    onError: function () {
      alert("Something went wrong. Please try again.");
    },
  });

  document.addEventListener("click", function (e) {
    const target = e.target as HTMLElement;
    if (target.id === "newsletter-close-btn" || target.id === "newsletter-success-overlay") {
      const overlay = document.getElementById("newsletter-success-overlay");
      overlay.classList.add("opacity-0", "pointer-events-none");
      overlay.querySelector("div:first-child").classList.add("scale-95");
    }
  });
</script>
<script src="https://unpkg.com/@formspree/ajax@1" defer is:inline></script>
